<%= form_with(model: category, html: { class: "task-form category-form" }) do |form| %>
  <% if category.errors.any? %>
    <div class="task-form-errors">
      <h2>
        <%= pluralize(category.errors.count, "erro") %>
        impediram a categoria de ser salva:
      </h2>

      <ul>
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="task-form-field">
    <%= form.label :title, "Nome da categoria" %>

    <%= form.text_field :title,
                        placeholder: "Ex.: Estudos",
                        autofocus: true,
                        required: true %>
  </div>

  <div class="task-form-field">
    <%= form.label :weight, "Peso da categoria" %>

    <%= form.number_field :weight,
                          min: 0,
                          placeholder: "Ex.: 1",
                          required: true %>

    <small>
      O peso será utilizado no cálculo da prioridade das tarefas.
    </small>
  </div>

  <div class="task-form-field">
    <%= form.label :color, "Cor da categoria" %>

    <div class="category-color-field">
      <%= form.color_field :color,
                           value: category.color.presence || "#22C55E",
                           class: "category-color-picker",
                           aria: { label: "Escolher cor da categoria" } %>

      <span class="category-color-help">
        Escolha a cor que identificará esta categoria na lista de tarefas.
      </span>
    </div>
  </div>

  <div class="task-form-actions">
    <%= form.submit "Salvar categoria", class: "task-form-submit" %>

    <%= link_to "Cancelar",
                categories_path,
                class: "task-form-cancel" %>
  </div>
<% end %>